{
  "name": "subabot",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "LGPL-3.0-or-later",
  "description": "A quieter way to follow the web. RSS signals, delivered to your inbox and Slack.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node ./dist/server/entry.mjs",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write --plugin=prettier-plugin-astro src tests playwright.config.ts astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/vercel": "^11.0.13",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}

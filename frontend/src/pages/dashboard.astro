---
import Layout from "@/layouts/Layout.astro";
import Dashboard from "@/components/Dashboard";
---

<Layout title="Your signal inbox | Subabot" noindex={true}>
  <Dashboard client:only="react">
    <div slot="fallback" class="app-loading" role="status">
      <span class="brand-icon" aria-hidden="true">
        <i></i>
        <i></i>
      </span>
      <p>Opening your signal inbox...</p>
      <a href="/">Back to Subabot</a>
    </div>
  </Dashboard>
  <noscript>
    <main id="main" style="max-width:600px;margin:100px auto;padding:24px">
      <h1>Your signal inbox</h1>
      <p>
        Enable JavaScript to manage your monitors and read your private inbox.
      </p>
      <a href="/">Back to Subabot</a>
    </main>
  </noscript>
</Layout>

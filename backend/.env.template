# Defaults work without credentials. Supply via exported variables or uv run --env-file.
SUBABOT_DATABASE_URL=sqlite:///./subabot.db
SUBABOT_FRONTEND_URL=http://localhost:4321
SUBABOT_SCHEDULER_ENABLED=true
SUBABOT_SCAN_INTERVAL_SECONDS=900
SUBABOT_SCAN_COOLDOWN_SECONDS=15
SUBABOT_FEED_TIMEOUT_SECONDS=12
SUBABOT_MAX_FEED_BYTES=2000000
SUBABOT_MAX_MONITORS=25
# Enable only behind the private frontend proxy, or with the shared secret below.
SUBABOT_TRUST_PROXY_CLIENT_IP=false
# Required for an internet-accessible backend that trusts proxy client addresses.
# Match the frontend's server-only BACKEND_PROXY_SECRET. Leave empty for private/local use.
SUBABOT_PROXY_SHARED_SECRET=
